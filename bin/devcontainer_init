#!/bin/bash
#
# devcontainer_init: runs on the host (devcontainer initializeCommand). Writes
# the gitignored ./.env that compose reads: the age key that opens
# env/development.env, and the compose files for development.
#
# Only the development key goes into the container, never production.

set -euo pipefail
cd "$(dirname "$0")/.."

find_key() {
	local keys_file="${SOPS_AGE_KEY_FILE:-$HOME/.config/sops/age/keys.txt}"

	if [[ -n "${SOPS_AGE_KEY:-}" ]]; then
		echo "$SOPS_AGE_KEY"
		return
	fi

	[[ -f "$keys_file" ]] || { echo "devcontainer_init: no age keys file at $keys_file" >&2; return 1; }

	local key
	while read -r key; do
		[[ "$key" == AGE-SECRET-KEY-* ]] || continue
		if grep -q "$(age-keygen -y <<<"$key")" env/development.env; then
			echo "$key"
			return
		fi
	done <"$keys_file"

	echo "devcontainer_init: no key in $keys_file opens env/development.env" >&2
	return 1
}

key="$(find_key)"
umask 077
cat >.env <<EOF
SOPS_AGE_KEY=$key
COMPOSE_FILE=compose.yaml:compose.development.yaml
EOF
