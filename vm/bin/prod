#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."

image=lukeclancy/otterly
sha=$(git rev-parse --short HEAD)

PROJECT_ENV=production docker compose build
docker tag otterly "$image:$sha"
docker tag otterly "$image:latest"
docker push "$image:$sha"
docker push "$image:latest"

[ "${1:-}" = "--start" ] && PROJECT_ENV=production docker compose up
