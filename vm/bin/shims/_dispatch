#!/bin/bash
#
# Made with claude
#
# Shared shim body - symlinked as dev/exec/run/test/prod. Inside the
# project, runs vm/bin/<name>. Outside it, falls through to whatever
# <name> resolves to further down $PATH (skipping this shim dir, so it
# doesn't just call itself).
set -euo pipefail

name=$(basename "$0")
shim_dir=$(cd "$(dirname "$0")" && pwd)
project_root=$(cd "$shim_dir/../../.." && pwd)

case "$PWD" in
	"$project_root"|"$project_root"/*)
		case "$name" in
			iex|mix)
				exec "$project_root/vm/bin/run" development "$name" "$@"
				;;
			*)
				exec "$project_root/vm/bin/$name" "$@"
				;;
		esac
		;;
esac

IFS=: read -ra path_dirs <<< "$PATH"
for dir in "${path_dirs[@]}"; do
	[ "$dir" = "$shim_dir" ] && continue
	if [ -x "$dir/$name" ]; then
		exec "$dir/$name" "$@"
	fi
done

echo "$name: command not found" >&2
exit 127
