#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."

case "${1:-}" in
	development|test|production|premix)
		export PROJECT_ENV=$1
		shift
		;;
	*)
		export PROJECT_ENV=development
		;;
esac

files=(-f compose.yaml)
[ "$PROJECT_ENV" != "production" ] && files+=(-f compose.dev.yaml)

# premix has no MIX_ENV baked in (it's the pre-deps.get base stage), so it
# never matches a running container - always gets a fresh one.
declare -A mix_env_for=( [development]=dev [test]=test [production]=prod )
wanted_mix_env=${mix_env_for[$PROJECT_ENV]:-}

if [ -n "$wanted_mix_env" ] && [ "$(docker inspect -f '{{.State.Running}}' otterly 2>/dev/null)" = "true" ]; then
	running_mix_env=$(docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' otterly | sed -n 's/^MIX_ENV=//p')
	if [ "$running_mix_env" = "$wanted_mix_env" ]; then
		exec docker compose "${files[@]}" exec otterly "${@:-bash}"
	fi
fi

exec docker compose "${files[@]}" run --rm otterly "${@:-bash}"
