FROM hexpm/elixir:1.20.3-erlang-29.0.5-alpine-3.24.1 AS base

RUN apk add --no-cache build-base git bash sops

WORKDIR /app
RUN mix local.hex --force && mix local.rebar --force
EXPOSE 4000

# Manifests first so deps.get is cached until mix.exs/mix.lock change.
FROM base AS install

COPY mix.exs mix.lock ./
RUN mix deps.get

FROM install AS development
ENV MIX_ENV=dev
RUN mix deps.compile
CMD ["bash", "-c", "source vm/utils/yaml_parsing.sh && decrypt_env development && exec mix phx.server"]

FROM base AS test
ENV MIX_ENV=test
RUN mix deps.compile
CMD ["bash", "-c", "source vm/utils/yaml_parsing.sh && decrypt_env test && exec mix test"]

FROM install AS production
COPY . .
ENV MIX_ENV=prod
RUN mix deps.compile --only prod
# TODO: assets.deploy (bun/tailwind) not wired up yet
RUN mix compile
CMD ["bash", "-c", "source vm/utils/yaml_parsing.sh && decrypt_env production && exec mix phx.server"]
