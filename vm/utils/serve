#!/bin/bash
#
# serve <env>: container entrypoint, `CMD ["vm/utils/serve", "<env>"]`.
# PROJECT_ENV goes into the shell rc files so a `docker exec` shell knows it.
# Then hands off to serve_app in vm/vm.conf.

set -euo pipefail
cd "$(dirname "$0")/../.."
source vm/vm.conf
serve_app "${1:-development}"