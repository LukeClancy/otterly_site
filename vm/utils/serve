#!/bin/bash
#
# serve <env>: container entrypoint, `CMD ["vm/utils/serve", "<env>"]`.
# PROJECT_ENV goes into the shell rc files so a `docker exec` shell knows it.
# Then hands off to serve_app in vm/vm.conf.

set -euo pipefail
cd "$(dirname "$0")/../.."

project_env="${1:-development}"

printf 'export PROJECT_ENV=%q\n' "$project_env" | tee -a /root/.bashrc >> /root/.profile

source vm/vm.conf
serve_app "$project_env"
