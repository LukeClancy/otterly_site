#!/bin/bash
#
# serve <env>: container entrypoint, `CMD ["vm/utils/serve", "<env>"]`.
# Only the access state (SOPS_AGE_KEY, PROJECT_ENV) goes into the shell rc
# files - the app decrypts its own creds, so a `docker exec` shell can pick
# its own env (eg. tests). Then hands off to serve_app in vm/deploy.conf.

set -euo pipefail
cd "$(dirname "$0")/../.."

project_env="${1:-development}"

printf 'export SOPS_AGE_KEY=%q\nexport PROJECT_ENV=%q\n' "$SOPS_AGE_KEY" "$project_env" | tee -a /root/.bashrc >> /root/.profile

source vm/deploy.conf
serve_app "$project_env"
