#!/bin/bash
#
# test_sops_creds: checks each key on this machine opens the creds it should.

set -euo pipefail
cd "$(dirname "$0")/../.."

check() {
	local key
	key="$(vm/utils/get_private_key "$1")"
	SOPS_AGE_KEY="$key" sops decrypt "vm/creds/$2.enc.yaml" >/dev/null || {
		echo "Could not decrypt $2 with $1 cred (length ${#key})" >&2
		exit 1
	}
}

check development development
check development test
check development shared
check production production
check production shared

echo "-- creds ok --"
