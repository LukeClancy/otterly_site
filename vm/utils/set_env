#!/bin/bash

set -euo pipefail

# Run from the repo root regardless of how we were invoked (devcontainer
# initializeCommand runs this from the workspace root; a hand-run may not).
cd "$(dirname "$0")/../.."

project_env="${PROJECT_ENV:-development}"

age_key="$(./vm/utils/get_private_key "$project_env")" || {
	echo "set_env: no matching age key found for '$project_env'" >&2
	exit 1
}

echo "SOPS_AGE_KEY=$age_key" > vm/.env
echo "PROJECT_ENV=$project_env" >> vm/.env
