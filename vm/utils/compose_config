#!/bin/bash
#
# compose_config: run on the host before compose.
#
#   vm/env			anything the sops key for the env can decrypt (the development key can decrypt development.enc.yaml and test.enc.yaml
#						so it decrypts both and both environment secrets are available in
#						the container). Takes into account the "shared" keyword.
#   vm/.env         compose config and project_environment

set -euo pipefail

# Run from the repo root regardless of how we were invoked.
cd "$(dirname "$0")/../.."
source vm/vm.conf

project_env="${1:-development}"

age_key="$(./vm/utils/get_private_key "$project_env")" || {
	echo "compose_config: no matching age key found for '$project_env'" >&2
	exit 1
}

echo "PROJECT_ENV=$project_env" > vm/.env
echo "COMPOSE_FILE=docker-compose.yaml:docker-compose.$project_env.yaml" >> vm/.env

# Every vm/creds/<group><env>.enc.yaml the age key can decrypt becomes
# vm/env/<group><env>, with <group>shared.enc.yaml (if present) first so env
# values override it. eg. with a key for development and test:
#   creds/shared + creds/development       -> env/development
#   creds/shared + creds/test              -> env/test
#   creds/pg_shared + creds/pg_development -> env/pg_development
print_yaml_env_vars() {
	[[ -f "$1" ]] || return 0
	local decrypted
	decrypted="$(SOPS_AGE_KEY="$age_key" sops decrypt "$1")" || {
		echo "flubbed it $1" >&2
		exit 1
	}
	vm/utils/parse_yaml <(printf '%s\n' "$decrypted")
}

rm -rf vm/env
mkdir -p vm/env

shopt -s nullglob
recipient="$(age-keygen -y <<< "$age_key")"
for env_file in vm/creds/*.enc.yaml; do
	name="$(basename "$env_file" .enc.yaml)"
	[[ "$name" == shared || "$name" == *_shared ]] && continue
	grep -q "$recipient" "$env_file" || continue

	group=""
	[[ "$name" == *_* ]] && group="${name%_*}_"

	{
		print_yaml_env_vars "vm/creds/${group}shared.enc.yaml"
		print_yaml_env_vars "$env_file"
	} > "vm/env/$name"
done
