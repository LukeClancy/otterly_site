#!/bin/bash
#
# compose_config: run on the host before compose (devcontainer
# initializeCommand, push_production). Writes two gitignored files for
# PROJECT_ENV (default development):
#
#   vm/.access_info  SOPS_AGE_KEY + PROJECT_ENV. Given to containers that
#                    decrypt creds themselves, so they can also switch to any
#                    env that key opens (eg. test inside development).
#   vm/.env          the decrypted creds as plain KEY="value" (+ PROJECT_ENV). Auto-loaded by
#                    compose for ${...}, for things that can't use sops (postgres).

set -euo pipefail

# Run from the repo root regardless of how we were invoked.
cd "$(dirname "$0")/../.."
source vm/deploy.conf

project_env="${PROJECT_ENV:-development}"

age_key="$(./vm/utils/get_private_key "$project_env")" || {
	echo "compose_config: no matching age key found for '$project_env'" >&2
	exit 1
}

echo "SOPS_AGE_KEY=$age_key" > vm/.access_info
echo "PROJECT_ENV=$project_env" >> vm/.access_info

# env variables used in docker compose read from .env
echo "PROJECT_ENV=$project_env" > vm/.env
echo "COMPOSE_FILE=docker-compose.yaml:docker-compose.$project_env.yaml" >> vm/.env
echo "REGISTRY=$REGISTRY" >> vm/.env

# support other services by dumping all config in .env
SOPS_AGE_KEY="$age_key" ./vm/utils/get_environment_config "$project_env" >> vm/.env
