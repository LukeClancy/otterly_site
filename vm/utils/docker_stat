#!/bin/bash
#
# docker_stat: lists images/tags in the registry on $SERVER and the
# containers running there.

set -euo pipefail
cd "$(dirname "$0")/../.."
source vm/deploy.conf

echo "=== registry images ==="

repos="$(curl -fsSL "http://$SERVER:5000/v2/_catalog" | jq -r '.repositories[]?')"
for repo in $repos; do
	tags="$(curl -fsSL "http://$SERVER:5000/v2/${repo}/tags/list" | jq -r '.tags[]? // empty')"
	if [ -z "$tags" ]; then
		echo "${repo} (no tags)"
		continue
	fi
	for tag in $tags; do
		echo "${repo}:${tag}"
	done
done

echo "=== server containers ==="

tailscale ssh "root@$SERVER" docker container list
