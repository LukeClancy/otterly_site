#!/bin/bash
#
# docker_stat: lists images/tags in the registry on $SERVER and the
# containers running there.

set -euo pipefail
cd "$(dirname "$0")/../.."
source vm/deploy.conf

echo "=== registry images ==="

auth="$(jq -r --arg reg "$REGISTRY" '.auths[$reg].auth // empty' ~/.docker/config.json)"
auth_header=()
[ -n "$auth" ] && auth_header=(-H "Authorization: Basic $auth")

repos="$(curl -fsSL "${auth_header[@]}" "$REGISTRY_URL/v2/_catalog" | jq -r '.repositories[]?')"
for repo in $repos; do
	tags="$(curl -fsSL "${auth_header[@]}" "$REGISTRY_URL/v2/${repo}/tags/list" | jq -r '.tags[]? // empty')"
	if [ -z "$tags" ]; then
		echo "${repo} (no tags)"
		continue
	fi
	for tag in $tags; do
		echo "${repo}:${tag}"
	done
done

echo "=== server containers ==="

ssh "$PROD_SSH_USR" docker container list
