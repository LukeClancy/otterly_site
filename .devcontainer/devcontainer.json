// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-existing-dockerfile
{
	"name": "otterly_site",
	"dockerComposeFile": ["../vm/docker-compose.yaml"],
	"service": "otterly_site",
	"shutdownAction": "stopCompose",
	"workspaceFolder": "/app",
	"forwardPorts": [ 4000 ],

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	
	// Runs on host before container start. Writes SOPS_AGE_KEY to vm/.env,
	// which docker-compose auto-loads for ${SOPS_AGE_KEY} interpolation.
	"initializeCommand": "./vm/utils/startup.sh",

	// Give claude some memory
	"mounts": [
		"source=${localEnv:HOME}/.claude,target=/root/.claude,type=bind"
	],
	"containerEnv": {
		"CLAUDE_CONFIG_DIR": "/root/.claude"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"JakeBecker.elixir-ls",
				"Anthropic.claude-code",
				"hoovercj.vscode-power-mode",
				"pixl-garden.BongoCat"
			]
		}
	}
}
