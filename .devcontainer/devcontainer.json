// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-existing-dockerfile
{
	"name": "otterly",
	// the below *may* be overridden by compose_config
	"dockerComposeFile": ["../vm/docker-compose.yaml", "../vm/docker-compose.development.yaml"],
	"service": "otterly",
	"shutdownAction": "stopCompose",
	"workspaceFolder": "/app",
	"forwardPorts": [ 4000 ],

	// Features to add to the dev container. More info: https://containers.dev/features.
	// https://code.claude.com/docs/en/devcontainer
	"features": {
		"ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
	},
	
	// Runs on host before container start. Writes vm/.access_info (age key, given
	// to the container) and vm/.env (decrypted creds, for compose interpolation).
	"initializeCommand": "./vm/utils/compose_config",

	// Dont want to deal with this vauge error right now. Run curl -fsSL https://claude.ai/install.sh | bash in the console.
	//
	// "postCreateCommand": "wget -qO /etc/apk/keys/claude-code.rsa.pub https://downloads.claude.ai/keys/claude-code.rsa.pub && echo https://downloads.claude.ai/claude-code/apk/stable >> /etc/apk/repositories && apk add claude-code",

	// Give claude some memory
	"mounts": [
		"source=${localEnv:HOME}/.claude,target=/root/.claude,type=bind"
	],
	"containerEnv": {
		"CLAUDE_CONFIG_DIR": "/root/.claude"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"JakeBecker.elixir-ls",
				"Anthropic.claude-code",
				"hoovercj.vscode-power-mode",
				"pixl-garden.BongoCat"
			]
		}
	}
}
